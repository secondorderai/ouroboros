 import path from 'node:path';
+import fs from 'node:fs/promises';
 import { extract as nativeExtract } from './binding.js';
 
+// Native extraction checks real directory components, writes files, then
+// creates archive symlinks. No archive link exists while files are written.
+// Its pending-link comparison misses some APFS aliases (for example Σ and ς),
+// so check each final link against the filesystem's actual resolution.
+async function checkSymlinks(dir) {
+  const root = await fs.realpath(dir);
+  async function visit(folder) {
+    for (const entry of await fs.readdir(folder, { withFileTypes: true })) {
+      const candidate = path.join(folder, entry.name);
+      if (entry.isDirectory()) {
+        await visit(candidate);
+      } else if (entry.isSymbolicLink()) {
+        let target;
+        try {
+          target = await fs.realpath(candidate);
+        } catch (error) {
+          await fs.unlink(candidate);
+          throw new Error(`extract: symlink target cannot be resolved: ${candidate}`, { cause: error });
+        }
+        const relative = path.relative(root, target);
+        if (relative === '..' || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {
+          await fs.unlink(candidate);
+          throw new Error(`extract: symlink escapes the extraction root: ${candidate}`);
+        }
+      }
+    }
+  }
+  await visit(root);
+}
