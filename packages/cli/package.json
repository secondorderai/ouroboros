{
  "name": "@ouroboros/cli",
  "version": "0.1.0",
  "description": "Ouroboros CLI — recursive self-improving AI agent",
  "type": "module",
  "main": "dist/ouroboros",
  "bin": {
    "ouroboros": "dist/ouroboros"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev-run": "bun run src/cli.ts",
    "build": "bun scripts/build.ts",
    "start": "./dist/ouroboros",
    "test": "bun test --path-ignore-patterns '**/e2e-live-llm*' --path-ignore-patterns '**/dist-cli*'",
    "test:live": "bun test tests/integration/e2e-live-llm.test.ts --timeout 120000",
    "test:all": "bun test --timeout 120000",
    "test:dist": "bun test tests/dist-cli.test.ts --timeout 60000",
    "lint": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "lint:fix": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "ts-check": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.133",
    "@ai-sdk/openai": "3.0.130",
    "@ai-sdk/openai-compatible": "2.0.85",
    "@ai-sdk/provider": "3.0.19",
    "@anthropic-ai/sandbox-runtime": "0.0.54",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@ouroboros/shared": "workspace:*",
    "@types/pg": "^8.20.0",
    "ai": "6.0.309",
    "better-sqlite3": "12.8.0",
    "commander": "14.0.3",
    "ink": "6.8.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "prettier": "3.8.1",
    "typescript": "6.0.2"
  }
}
